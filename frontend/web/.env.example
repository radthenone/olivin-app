# Domyślny adres backendu w środowisku deweloperskim. Port zgodny z
# DJANGO_PORT z konfiguracji kontenerów. Produkcja nadpisuje to zmienną
# środowiskową.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8020

# Opcjonalny adres API katalogu (ADR 0034). Fallback: NEXT_PUBLIC_BACKEND_URL.
# W CI wskazuje stub katalogu (np. http://localhost:3200).
# CATALOG_API_URL=http://localhost:3200

# Sekret rewalidacji keszu katalogu na webie (ADR 0034, #318, #358).
# Backend przesyła go w nagłówku X-Revalidate-Secret przy POST /api/revalidate.
# Pusta wartość wyłącza autoryzację rewalidacji (żądania są odrzucane ze statusem 401).
REVALIDATE_SECRET=
