{
  "name": "@olivin/web",
  "version": "0.0.0",
  "private": true,
  "prettier": "@olivin/config/prettier/index.json",
  "scripts": {
    "tokens": "node scripts/generate-tokens-css.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "node scripts/check-ui-purity.mjs && eslint .",
    "lint:fix": "node scripts/check-ui-purity.mjs && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./scripts ./src",
    "e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\""
  },
  "dependencies": {
    "@olivin/api": "workspace:*",
    "@olivin/features": "workspace:*",
    "@olivin/i18n": "workspace:*",
    "@olivin/tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@olivin/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
