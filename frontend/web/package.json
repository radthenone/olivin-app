{
  "name": "@olivin/web",
  "version": "0.0.0",
  "private": true,
  "prettier": "@olivin/config/prettier/index.json",
  "scripts": {
    "tokens": "node scripts/generate-tokens-css.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\""
  },
  "dependencies": {
    "@olivin/api": "workspace:*",
    "@olivin/tokens": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "next": "^16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@olivin/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
