{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Olivin base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
