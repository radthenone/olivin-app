{
  "name": "@olivin/config",
  "version": "0.0.0",
  "private": true,
  "description": "Wspólna konfiguracja narzędzi dla wszystkich workspace'ów frontendu",
  "files": [
    "tsconfig",
    "eslint",
    "prettier"
  ],
  "prettier": "./prettier/index.json",
  "scripts": {
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\""
  }
}
