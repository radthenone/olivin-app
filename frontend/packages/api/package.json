{
  "name": "@olivin/api",
  "version": "0.0.0",
  "private": true,
  "description": "Klient API obu schematów wraz z kontraktem transportu",
  "main": "./index.ts",
  "types": "./index.ts",
  "prettier": "@olivin/config/prettier/index.json",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "orval",
    "generate:watch": "orval --watch",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json}\"",
    "generate:check": "orval --config orval.check.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@olivin/config": "workspace:*",
    "dotenv": "^18.0.5",
    "orval": "^8.40.0",
    "typescript": "~6.0.3"
  }
}
