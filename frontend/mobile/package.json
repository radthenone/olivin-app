{
  "name": "@olivin/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --lan --dev-client",
    "start:clear": "expo start --lan --dev-client --clear",
    "start:go": "expo start --lan",
    "start:go:clear": "expo start --lan --clear",
    "prebuild:android": "expo prebuild --clean --platform android",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@olivin/api": "workspace:*",
    "@olivin/tokens": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.42",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.3",
    "dotenv-expand": "^12.0.3",
    "expo": "~57.0.23",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "prettier": "@olivin/config/prettier/index.json",
  "devDependencies": {
    "@olivin/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/react": "~19.2.0",
    "ajv": "^8.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "ws": "^8.21.3"
  },
  "private": true,
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ]
}
